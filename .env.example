# Copy to .env at the repository root; supply your own test account values.
# Empty credential values intentionally fail preflight.
EXAMPLE_USERNAME=
EXAMPLE_EMAIL=
EXAMPLE_PASSWORD=
# Receiving Gmail address for the Expand Testing OTP profile.
EXPANDTESTING_EMAIL=
# Public Practice Test Automation demo; local .env values are populated separately.
PRACTICE_LOGIN_USERNAME=
PRACTICE_LOGIN_PASSWORD=
GOOGLE_API_KEY=

# Paths below are relative to the project root unless absolute.
AUTOWEB_HEADLESS=true
AUTOWEB_BROWSER=chromium
AUTOWEB_LAUNCH_TIMEOUT_MS=30000
AUTOWEB_GMAIL_CREDENTIALS_FILE=secrets/gmail/credentials.json
AUTOWEB_GMAIL_TOKEN_FILE=secrets/gmail/token.json
AUTOWEB_ARTIFACTS_DIR=artifacts
AUTOWEB_AI_ENABLED=false
# Set AUTOWEB_AI_MODEL explicitly before enabling AI.
# AUTOWEB_AI_MODEL=
# Set AUTOWEB_ROOT when using the package with a different configuration root.
# AUTOWEB_ROOT=
