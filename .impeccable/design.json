  "narrative": {
    "northStar": "Split workspace",
    "overview": "AutoWeb Studio uses the user-selected graphite and teal palette: a quiet dark workspace with clearly marked actions and inspectable execution state. Dense information stays legible through restrained headings, generous section padding, and a separate monospace voice for measurements.\n\nSurfaces are flat and divided by fine borders. Teal connects the primary action, current navigation, selected step, and keyboard focus; semantic status colors explain waiting and failure alongside text and icons.",
    "keyCharacteristics": [
      "Graphite surfaces with teal interaction cues.",
      "Compact controls and readable operational detail.",
      "Flat tonal layering and thin structural dividers.",
      "DM Sans interface paired with IBM Plex Mono data."
    ],
    "rules": [
