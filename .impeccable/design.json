      "html": "<nav class=\"ds-nav\" aria-label=\"Example navigation\"><a href=\"#workspace\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"M3 9h18M9 9v11\"/></svg>Workspace</a></nav>",
      "css": ".ds-nav{max-width:200px;background:var(--sidebar,#14181c);padding:10px;font-family:'DM Sans Variable', 'DM Sans', sans-serif;font-size:14px;}.ds-nav a{display:flex;align-items:center;gap:11px;padding:12px 13px;border-radius:7px;font-weight:500;color:#b0bbc4;text-decoration:none;}.ds-nav a:hover{background:#262d34;color:var(--text,#e7ebef);}.ds-nav a[aria-current]{background:#213a39;color:#90e7dc;}.ds-nav a:focus-visible{outline:2px solid var(--accent,#5ed3c4);outline-offset:4px;}"
    },
    {
      "name": "Waiting status badge",
      "kind": "chip",
      "refersTo": "chip-waiting",
      "description": "Noninteractive state label paired with a visible dot.",
      "html": "<span class=\"ds-waiting\"><span aria-hidden=\"true\"></span>Waiting</span>",
      "css": ".ds-waiting{display:inline-flex;align-items:center;gap:7px;padding:5px 9px;border-radius:5px;font-family:'DM Sans Variable', 'DM Sans', sans-serif;font-size:12px;white-space:nowrap;background:var(--amber-surface,#332e25);color:var(--amber,#f0cb8d);}.ds-waiting>span{width:6px;height:6px;border-radius:50%;background:currentColor;}"
    },
    {
      "name": "Configuration container",
      "kind": "card",
      "refersTo": "configuration-card",
      "description": "Flat settings panel with structural border.",
      "html": "<section class=\"ds-card\"><h2>Run configuration</h2><p>Choose the profile and browser settings for the next demo.</p></section>",
      "css": ".ds-card{padding:23px 32px;background:#20262c;border:1px solid var(--border,#343d46);border-radius:8px;color:var(--text,#e7ebef);font-family:'DM Sans Variable', 'DM Sans', sans-serif;font-size:14px;}.ds-card h2{font-size:18px;font-weight:550;letter-spacing:-.4px;line-height:1.35;margin:0 0 5px;}.ds-card p{font-size:13px;line-height:1.65;color:var(--muted,#a5b3be);margin:0;}"
    },
    {
      "name": "Selected execution step",
      "kind": "custom",
      "refersTo": "step-selected",
      "description": "Current step with progress marker and operational detail.",
      "html": "<button class=\"ds-step\" aria-current=\"step\"><span class=\"ds-marker\">4</span><span class=\"ds-copy\"><span class=\"ds-title\">Wait for verification email</span><span class=\"ds-subtitle\">Checking for a fresh message</span></span><span class=\"ds-duration\">12.0s</span></button>",
      "css": ".ds-step{display:flex;align-items:flex-start;gap:11px;width:100%;max-width:320px;padding:13px 11px;border:1px solid #507d76;border-radius:8px;background:var(--accent-surface,#233a3a);color:var(--text,#e7ebef);text-align:left;cursor:pointer;transition:background-color 180ms ease-out,border-color 180ms ease-out;font-family:'DM Sans Variable', 'DM Sans', sans-serif;font-size:14px;}.ds-step:hover{background:#283239;}.ds-marker{display:grid;place-items:center;flex-shrink:0;width:23px;height:23px;border:1px solid #6acfc1;border-radius:50%;color:var(--accent,#5ed3c4);font-family:'IBM Plex Mono', monospace;font-size:12px;}.ds-copy{display:block;flex:1;min-width:0;}.ds-title{display:block;color:var(--accent-text,#b8f0e8);font-size:13px;font-weight:500;line-height:1.5;margin-top:1px;}.ds-subtitle{display:block;color:#bbd1cc;font-size:12px;line-height:1.45;margin-top:4px;}.ds-duration{font-family:'IBM Plex Mono', monospace;font-size:12px;padding-top:4px;color:#b5c4ce;font-variant-numeric:tabular-nums;}.ds-step:focus-visible{outline:2px solid var(--accent,#5ed3c4);outline-offset:4px;}@media(prefers-reduced-motion:reduce){.ds-step{transition:none;}}"
    },
