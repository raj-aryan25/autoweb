      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:10px 14px;min-height:40px;border:1px solid #47535c;border-radius:7px;background:transparent;color:var(--text,#e7ebef);font-weight:500;white-space:nowrap;cursor:pointer;font-family:'DM Sans Variable', 'DM Sans', sans-serif;font-size:14px;background:var(--accent,#5ed3c4);border-color:transparent;color:#12332d;font-weight:600;}.ds-primary:hover:not(:disabled){background:#87e3d6;}.ds-primary:disabled{background:#2b4541;color:#b0c4bd;cursor:not-allowed;}.ds-primary:focus-visible{outline:2px solid var(--accent,#5ed3c4);outline-offset:4px;}"
