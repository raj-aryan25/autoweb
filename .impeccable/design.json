      "css": ".ds-select-label{display:flex;flex-direction:column;gap:9px;max-width:300px;color:#c1ced6;font-size:12px;font-family:'DM Sans Variable', 'DM Sans', sans-serif;}.ds-select{width:100%;min-height:41px;padding:10px 12px;background:#181e23;border:1px solid #50606d;color:var(--text,#e7ebef);border-radius:6px;font-size:13px;font-family:'DM Sans Variable', 'DM Sans', sans-serif;padding-right:24px;color-scheme:dark;}.ds-select:focus-visible{outline:2px solid var(--accent,#5ed3c4);outline-offset:4px;}"
