{
  "schema_version": 1,
  "name": "example-password",
  "entry_url": "https://example.com/login",
  "login_mode": "password",
  "credentials": {
    "username": {
      "env": "EXAMPLE_USERNAME"
    },
    "password": {
      "env": "EXAMPLE_PASSWORD"
    }
  },
  "steps": [
    {
      "action": "accept_cookies",
      "target": {
        "by": "role",
        "value": "button",
        "name": "Accept all"
      },
      "optional": true
    },
    {
      "action": "fill",
      "target": {
        "by": "label",
        "value": "Username"
      },
      "credential": "username"
    },
    {
      "action": "fill",
      "target": {
        "by": "label",
        "value": "Password"
      },
      "credential": "password"
    },
    {
      "action": "submit",
      "target": {
        "by": "role",
        "value": "button",
        "name": "Sign in"
      }
    }
  ],
  "success": [
    {
      "type": "element",
      "target": {
        "by": "test_id",
        "value": "account-menu"
      }
    },
    {
      "type": "url",
      "pattern": "https://example.com/account*"
    }
  ],
  "failure": [
    {
      "type": "element",
      "target": {
        "by": "test_id",
        "value": "login-error"
      }
    }
  ]
}
