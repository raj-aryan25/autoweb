{
  "schema_version": 1,
  "name": "local-password",
  "entry_url": "http://127.0.0.1:8765/login",
  "login_mode": "password",
  "credentials": {
    "username": {
      "env": "LOCAL_LOGIN_USERNAME"
    },
    "password": {
      "env": "LOCAL_LOGIN_PASSWORD"
    }
  },
  "steps": [
    {
      "action": "accept_cookies",
      "target": {
        "by": "role",
        "value": "button",
        "name": "Accept all"
      },
      "optional": true,
      "timeout_ms": 1000
    },
    {
      "action": "fill",
      "target": {
        "by": "label",
        "value": "Username"
      },
      "credential": "username"
    },
    {
      "action": "fill",
      "target": {
        "by": "label",
        "value": "Password"
      },
      "credential": "password"
    },
    {
      "action": "submit",
      "target": {
        "by": "role",
        "value": "button",
        "name": "Sign in"
      }
    }
  ],
  "success": [
    {
      "type": "element",
      "target": {
        "by": "test_id",
        "value": "account-menu"
      }
    },
    {
      "type": "url",
      "pattern": "**/protected"
    },
    {
      "type": "api",
      "url": "/api/session",
      "expected_status": 200,
      "expected_json": {
        "authenticated": true
      }
    }
  ],
  "failure": [
    {
      "type": "element",
      "target": {
        "by": "test_id",
        "value": "login-error"
      }
    }
  ]
}
